PORT=3000
ORIGIN=http://localhost:3000
RP_ID=localhost
RP_NAME="SharmaWeb Sign In"
SESSION_SECRET=replace-with-a-long-random-secret
WORKSPACE_DOMAIN=sharmaweb.com

# Existing Google OAuth client mode for this app's own "Continue with Google" button.
# Create these in Google Cloud Console and add this authorized redirect URI:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# When true, Google sign-ins must be completed with an existing passkey.
# Leave false for first-time local verification before a passkey is registered.
REQUIRE_PASSKEY_AFTER_GOOGLE=false

# Google Workspace custom OIDC profile mode. Generate secrets with:
# npm run generate:oidc-secrets
OIDC_CLIENT_ID=sharmaweb-workspace
OIDC_CLIENT_SECRET=
OIDC_PRIVATE_KEY_JWK=

# After saving the custom OIDC profile in Google Workspace Admin, copy Google's
# generated Redirect URI into this comma-separated allow-list.
OIDC_REDIRECT_URIS=

# First passkey enrollment controls. Prefer BOOTSTRAP_EMAILS for specific users;
# add BOOTSTRAP_CODE when you want an additional shared enrollment code.
BOOTSTRAP_EMAILS=admin@sharmaweb.com
BOOTSTRAP_CODE=
ALLOW_DOMAIN_BOOTSTRAP=false
ALLOW_OIDC_WITHOUT_PASSKEY=false
